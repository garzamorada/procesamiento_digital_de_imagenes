      "source": [
        "import gradio as gr"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def saludo(nombre, intensidad):\n",
        "  return \"Hola, \" + nombre + \"!\" * int(intensidad)"
      ],
      "metadata": {
        "id": "6PyRBpo_wAMz"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "demo = gr.Interface(\n",
        "  fn=saludo,\n",
        "  inputs=[\"text\", \"slider\"],\n",
        "  outputs=[\"text\"],\n",
        ")\n",
        "\n",
        "demo.launch()"
      ],
